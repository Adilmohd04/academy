# Backend Environment Variables Template
# Copy this file to .env and fill in your values

# ==========================================
# SERVER CONFIGURATION
# ==========================================
NODE_ENV=production
PORT=5000

# Frontend URL (for CORS)
FRONTEND_URL=https://your-frontend.vercel.app
CORS_ORIGIN=https://your-frontend.vercel.app

# Canonical *public frontend* URL used in every certificate QR code and
# verification link. Required in production. It may be either the frontend
# origin or its /verify root, and must be HTTPS (never an internal API URL).
# Examples: https://academy.example  OR  https://academy.example/verify
VERIFICATION_PORTAL_URL=https://your-frontend.vercel.app/verify

# Keep false when this backend can be reached directly from the internet.
# Set a numeric hop count (for example 1) or explicit trusted proxy CIDRs only
# when a trusted reverse proxy overwrites forwarded client-IP headers.
# Never set this to true/all/*. It would make client-supplied X-Forwarded-For
# values trustworthy and let users bypass IP-based rate limits.
TRUST_PROXY=false

# ==========================================
# DATABASE (Supabase)
# ==========================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres

# ==========================================
# AUTHENTICATION (Clerk)
# ==========================================
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_WEBHOOK_SECRET=whsec_xxx

# Optional server-to-server auth bridge. Use one high-entropy value shared
# only with the Next.js server. Do not expose it via a NEXT_PUBLIC_ variable.
INTERNAL_AUTH_SHARED_SECRET=

# ==========================================
# PAYMENTS (Razorpay - Primary)
# ==========================================
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx

# ==========================================
# PAYMENTS (Stripe - Secondary)
# ==========================================
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# ==========================================
# GOOGLE CALENDAR INTEGRATION
# ==========================================
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx
GOOGLE_REDIRECT_URI=https://your-backend-url/api/calendar/callback

# ==========================================
# EMAIL NOTIFICATIONS
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
FROM_EMAIL=noreply@yourdomain.com

# ==========================================
# RATE LIMITING
# ==========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Public certificate verification is deliberately more restrictive than the
# general API limiter. These keys are evaluated from the server-trusted peer
# IP (or explicitly configured proxy chain), never a browser-forwarded header.
VERIFICATION_RATE_LIMIT_WINDOW_MS=60000
VERIFICATION_RATE_LIMIT_MAX_REQUESTS=60
