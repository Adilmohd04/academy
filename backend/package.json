{
  "name": "education-platform-backend",
  "version": "1.0.0",
  "description": "Scalable education management platform backend - Supports 10K+ concurrent users",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:cluster": "cross-env NODE_ENV=production ENABLE_CLUSTER=true node dist/server.js",
    "vercel-build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --reporters=default --reporters=jest-junit",
    "test:chaos": "node scripts/multi-agent-chaos-orchestrator.js",
    "check:secrets": "node scripts/check-secrets.js",
    "check-env": "node src/scripts/check-env.js",
    "audit:unused": "node scripts/audit-unused-files.mjs",
    "load:smoke": "k6 run load/k6-smoke.js",
    "load:10k": "k6 run load/k6-10k-ramp.js",
    "load:10k:mixed": "k6 run load/k6-10k-mixed-activity.js"
  },
  "engines": {
    "node": ">=18.x"
  },
  "keywords": [
    "education",
    "api",
    "scalable"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.958.0",
    "@clerk/clerk-sdk-node": "^5.0.0",
    "@clerk/express": "^1.7.62",
    "@supabase/supabase-js": "^2.78.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "date-fns": "^2.30.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "googleapis": "^166.0.0",
    "helmet": "^7.1.0",
    "ics": "^3.8.1",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^7.0.12",
    "openai": "^6.17.0",
    "pdfkit": "^0.15.0",
    "puppeteer": "^24.34.0",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.6",
    "svix": "^1.81.0",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.3",
    "@types/pdfkit": "^0.13.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "cross-env": "^10.1.0",
    "fast-check": "^4.7.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
